# Reviewed non-secret v1 contract. Keep these values exact in staging.
MAIN_FINANCE_PROTOCOL_MODE=disabled
MAIN_FINANCE_PRODUCT_CODE=architecture_finance
MAIN_FINANCE_ISSUER_PATH=/functions/v1/finance-issue-code
MAIN_FINANCE_ALLOWED_ORIGINS=https://main-staging.example.com
MAIN_FINANCE_UPSTREAM_ISSUER_URL=https://finance-project.supabase.co/functions/v1/finance-issue-telegram-code
MAIN_FINANCE_UPSTREAM_CANONICAL_PATH=/functions/v1/finance-issue-telegram-code

# Four different server-only secrets. Empty examples fail closed. Never put
# real values in this file, frontend source, URLs, logs or committed config.
TELEGRAM_BOT_TOKEN=
MAIN_FINANCE_PRIVACY_HMAC_KEY=
MAIN_FINANCE_NONCE_DERIVATION_KEY=
MAIN_FINANCE_ISSUER_HMAC_SECRET=

# Bounded defaults shown explicitly for staging review. The two Telegram
# settings plus the fixed 60-second replay safety margin can never exceed the
# database's exact 15-minute replay window (allowed maxima: 780 + 60 + 60).
MAIN_TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
MAIN_TELEGRAM_INIT_DATA_MAX_FUTURE_SKEW_SECONDS=15
MAIN_FINANCE_MAX_BODY_BYTES=12288
MAIN_FINANCE_BODY_TIMEOUT_MS=3000
MAIN_FINANCE_DB_TIMEOUT_MS=5000
MAIN_FINANCE_TOTAL_TIMEOUT_MS=24000
MAIN_FINANCE_UPSTREAM_MAX_AGE_SECONDS=60
MAIN_FINANCE_UPSTREAM_TIMEOUT_MS=8000
MAIN_FINANCE_UPSTREAM_MAX_RESPONSE_BYTES=2048

# Private Main -> Finance entitlement worker. It is disabled by default and
# accepts exact POST {} or one canonical {"event_id":"<UUIDv4>"} with the
# separate server trigger header. The operator uses the targeted form.
MAIN_FINANCE_SYNC_MODE=disabled
MAIN_FINANCE_SYNC_PATH=/functions/v1/finance-sync-entitlements
MAIN_FINANCE_ENTITLEMENT_UPSTREAM_URL=https://finance-project.supabase.co/functions/v1/finance-apply-entitlement-event
MAIN_FINANCE_ENTITLEMENT_CANONICAL_PATH=/functions/v1/finance-apply-entitlement-event
MAIN_FINANCE_SYNC_TRIGGER_SECRET=
MAIN_FINANCE_ENTITLEMENT_HMAC_SECRET=
MAIN_FINANCE_SYNC_BODY_TIMEOUT_MS=2000
MAIN_FINANCE_SYNC_DB_TIMEOUT_MS=5000
MAIN_FINANCE_SYNC_TOTAL_TIMEOUT_MS=24000
MAIN_FINANCE_SYNC_UPSTREAM_TIMEOUT_MS=6000
MAIN_FINANCE_SYNC_MAX_RESPONSE_BYTES=2048
MAIN_FINANCE_SYNC_BATCH_SIZE=3
MAIN_FINANCE_SYNC_LEASE_SECONDS=60

# SUPABASE_URL and SUPABASE_SECRET_KEYS are supplied by hosted Supabase Edge.
# A legacy local stack may use SUPABASE_SERVICE_ROLE_KEY. MAIN_SUPABASE_SECRET_KEY
# is an explicit local/staging override and must never be exposed to a browser.
